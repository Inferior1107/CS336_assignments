\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}linear}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}in}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}out}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
