\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}model\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given the weights of an Embedding layer, get the embeddings for a batch of token ids.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        vocab\PYGZus{}size (int): The number of embeddings in the vocabulary}
\PYG{l+s+sd}{        d\PYGZus{}model (int): The size of the embedding dimension}
\PYG{l+s+sd}{        weights (Float[Tensor, \PYGZdq{}vocab\PYGZus{}size d\PYGZus{}model\PYGZdq{}]): The embedding vectors to fetch from}
\PYG{l+s+sd}{        token\PYGZus{}ids (Int[Tensor, \PYGZdq{}...\PYGZdq{}]): The set of token ids to fetch from the Embedding layer}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}... d\PYGZus{}model\PYGZdq{}]: Batch of embeddings returned by your Embedding layer.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{model} \PYG{o}{=} \PYG{n}{Embedding}\PYG{p}{(}
        \PYG{n}{num\PYGZus{}embeddings}\PYG{o}{=}\PYG{n}{vocab\PYGZus{}size}\PYG{p}{,}
        \PYG{n}{embedding\PYGZus{}dim}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{weights}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{weights}\PYG{o}{.}\PYG{n}{dtype}
    \PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}weight\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{\PYGZcb{},} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{token\PYGZus{}ids}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}swiglu}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}ff}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{w1\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}ff d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{w2\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}model d\PYGZus{}ff\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{w3\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}ff d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}model\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Given the weights of a SwiGLU network, return}
\PYG{l+s+sd}{    the output of your implementation with these weights.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}model (int): Dimensionality of the feedforward input and output.}
\PYG{l+s+sd}{        d\PYGZus{}ff (int): Dimensionality of the up\PYGZhy{}project happening internally to your swiglu.}
\PYG{l+s+sd}{        w1\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}ff d\PYGZus{}model\PYGZdq{}]): Stored weights for W1}
\PYG{l+s+sd}{        w2\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}model d\PYGZus{}ff\PYGZdq{}]): Stored weights for W2}
\PYG{l+s+sd}{        w3\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}ff d\PYGZus{}model\PYGZdq{}]): Stored weights for W3}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}... d\PYGZus{}model\PYGZdq{}]): Input embeddings to the feed\PYGZhy{}forward layer.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}... d\PYGZus{}model\PYGZdq{}]: Output embeddings of the same shape as the input embeddings.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} Example:}
    \PYG{c+c1}{\PYGZsh{} If your state dict keys match, you can use `load\PYGZus{}state\PYGZus{}dict()`}
    \PYG{c+c1}{\PYGZsh{} swiglu.load\PYGZus{}state\PYGZus{}dict(weights)}
    \PYG{c+c1}{\PYGZsh{} You can also manually assign the weights}
    \PYG{c+c1}{\PYGZsh{} swiglu.w1.weight.data = w1\PYGZus{}weight}
    \PYG{c+c1}{\PYGZsh{} swiglu.w2.weight.data = w2\PYGZus{}weight}
    \PYG{c+c1}{\PYGZsh{} swiglu.w3.weight.data = w3\PYGZus{}weight}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{SwiGLU}\PYG{p}{(}
        \PYG{n}{d\PYGZus{}model}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{d\PYGZus{}ff}\PYG{o}{=}\PYG{n}{d\PYGZus{}ff}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{dtype}
    \PYG{p}{)}

    \PYG{n}{state\PYGZus{}dict} \PYG{o}{=} \PYG{p}{\PYGZob{}}
        \PYG{l+s+s2}{\PYGZdq{}w1.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{w1\PYGZus{}weight}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}w2.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{w2\PYGZus{}weight}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}w3.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{w3\PYGZus{}weight}
    \PYG{p}{\PYGZcb{}}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(}\PYG{n}{state\PYGZus{}dict}\PYG{p}{,} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}scaled\PYGZus{}dot\PYGZus{}product\PYGZus{}attention}\PYG{p}{(}
    \PYG{n}{Q}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... queries d\PYGZus{}k\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{K}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... keys d\PYGZus{}k\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{V}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... values d\PYGZus{}v\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{mask}\PYG{p}{:} \PYG{n}{Bool}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... queries keys\PYGZdq{}}\PYG{p}{]} \PYG{o}{|} \PYG{k+kc}{None} \PYG{o}{=} \PYG{k+kc}{None}\PYG{p}{,}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... queries d\PYGZus{}v\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given key (K), query (Q), and value (V) tensors, return}
\PYG{l+s+sd}{    the output of your scaled dot product attention implementation.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        Q (Float[Tensor, \PYGZdq{} ... queries d\PYGZus{}k\PYGZdq{}]): Query tensor}
\PYG{l+s+sd}{        K (Float[Tensor, \PYGZdq{} ... keys d\PYGZus{}k\PYGZdq{}]): Key tensor}
\PYG{l+s+sd}{        V (Float[Tensor, \PYGZdq{} ... values d\PYGZus{}v\PYGZdq{}]): Values tensor}
\PYG{l+s+sd}{        mask (Bool[Tensor, \PYGZdq{} ... queries keys\PYGZdq{}] | None): Mask tensor}
\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{} ... queries d\PYGZus{}v\PYGZdq{}]: Output of SDPA}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 提取 d\PYGZus{}k 的维度大小，用于后续的缩放}
    \PYG{n}{d\PYGZus{}k} \PYG{o}{=} \PYG{n}{Q}\PYG{o}{.}\PYG{n}{size}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 1. 计算打分矩阵并缩放: (Q @ K\PYGZca{}T) / sqrt(d\PYGZus{}k)}
    \PYG{c+c1}{\PYGZsh{} K.transpose(\PYGZhy{}2, \PYGZhy{}1) 的魔法：只反转最后两个维度 (keys 和 d\PYGZus{}k)，}
    \PYG{c+c1}{\PYGZsh{} 完全无视前面有多少个 batch 维度 (...)，极其优雅安全！}
    \PYG{c+c1}{\PYGZsh{} 结果 scores 的形状将会是: (... queries, keys)}
    \PYG{n}{scores} \PYG{o}{=} \PYG{p}{(}\PYG{n}{Q} \PYG{o}{@} \PYG{n}{K}\PYG{o}{.}\PYG{n}{transpose}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{2}\PYG{p}{,} \PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{))} \PYG{o}{/} \PYG{n}{math}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{d\PYGZus{}k}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 2. 应用掩码 (Masking)}
    \PYG{k}{if} \PYG{n}{mask} \PYG{o+ow}{is} \PYG{o+ow}{not} \PYG{k+kc}{None}\PYG{p}{:}
        \PYG{c+c1}{\PYGZsh{} mask 中值为 True 表示“允许看”，False 表示“遮挡不允许看”。}
        \PYG{c+c1}{\PYGZsh{} \PYGZti{}mask 取反后，把所有不允许看的位置强制填充为 \PYGZhy{}inf}
        \PYG{n}{scores} \PYG{o}{=} \PYG{n}{scores}\PYG{o}{.}\PYG{n}{masked\PYGZus{}fill}\PYG{p}{(}\PYG{o}{\PYGZti{}}\PYG{n}{mask}\PYG{p}{,} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}\PYGZhy{}inf\PYGZsq{}}\PYG{p}{))}

    \PYG{c+c1}{\PYGZsh{} 3. Softmax 归一化}
    \PYG{c+c1}{\PYGZsh{} 沿着最后一个维度 (keys) 将得分转化为概率分布。}
    \PYG{c+c1}{\PYGZsh{} 这里你可以调用上一题自己手写的 run\PYGZus{}softmax(scores, dim=\PYGZhy{}1)，}
    \PYG{c+c1}{\PYGZsh{} 但为了保证在多维 Tensor 上的极致性能，直接调用内置的 torch.softmax 也是绝佳选择。}
    \PYG{n}{attention\PYGZus{}weights} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{softmax}\PYG{p}{(}\PYG{n}{scores}\PYG{p}{,} \PYG{n}{dim}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 4. 乘以 V (提取信息)}
    \PYG{c+c1}{\PYGZsh{} attention\PYGZus{}weights 形状: (... queries, keys)}
    \PYG{c+c1}{\PYGZsh{} V 形状: (... keys, d\PYGZus{}v)}
    \PYG{c+c1}{\PYGZsh{} 矩阵乘法后得到最终结果形状: (... queries, d\PYGZus{}v)}
    \PYG{n}{output} \PYG{o}{=} \PYG{n}{attention\PYGZus{}weights} \PYG{o}{@} \PYG{n}{V}

    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}multihead\PYGZus{}self\PYGZus{}attention}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{num\PYGZus{}heads}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{q\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}k d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{k\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}k d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{v\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}v d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{o\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}model d\PYGZus{}v\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}out\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given the key, query, and value projection weights of a naive unbatched}
\PYG{l+s+sd}{    implementation of multi\PYGZhy{}head attention, return the output of an optimized batched}
\PYG{l+s+sd}{    implementation. This implementation should handle the key, query, and value projections}
\PYG{l+s+sd}{    for all heads in a single matrix multiply.}
\PYG{l+s+sd}{    This function should not use RoPE.}
\PYG{l+s+sd}{    See section 3.2.2 of Vaswani et al., 2017.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}model (int): Dimensionality of the feedforward input and output.}
\PYG{l+s+sd}{        num\PYGZus{}heads (int): Number of heads to use in multi\PYGZhy{}headed attention.}
\PYG{l+s+sd}{        max\PYGZus{}seq\PYGZus{}len (int): Maximum sequence length to pre\PYGZhy{}cache if your implementation does that.}
\PYG{l+s+sd}{        q\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the Q projection}
\PYG{l+s+sd}{        k\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the K projection}
\PYG{l+s+sd}{        v\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the V projection}
\PYG{l+s+sd}{        o\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}model d\PYGZus{}v\PYGZdq{}]): Weights for the output projection}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}... sequence\PYGZus{}length d\PYGZus{}in\PYGZdq{}]): Tensor to run your implementation on.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}out\PYGZdq{}]: Tensor with the output of running your optimized, batched multi\PYGZhy{}headed attention}
\PYG{l+s+sd}{        implementation with the given QKV projection weights and input features.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 实例化}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{MultiHeadAttention}\PYG{p}{(}
        \PYG{n}{d\PYGZus{}model}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{num\PYGZus{}heads}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{dtype}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 2. 加载权重 (由于我们的 Linear 类内部参数叫 W，所以加 .W 后缀)}
    \PYG{n}{state\PYGZus{}dict} \PYG{o}{=} \PYG{p}{\PYGZob{}}
        \PYG{l+s+s2}{\PYGZdq{}q\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{q\PYGZus{}proj\PYGZus{}weight}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}k\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{k\PYGZus{}proj\PYGZus{}weight}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}v\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{v\PYGZus{}proj\PYGZus{}weight}\PYG{p}{,}
        \PYG{l+s+s2}{\PYGZdq{}o\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{o\PYGZus{}proj\PYGZus{}weight}
    \PYG{p}{\PYGZcb{}}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(}\PYG{n}{state\PYGZus{}dict}\PYG{p}{,} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 3. 执行推理}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}multihead\PYGZus{}self\PYGZus{}attention\PYGZus{}with\PYGZus{}rope}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{num\PYGZus{}heads}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{theta}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{,}
    \PYG{n}{q\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}k d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{k\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}k d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{v\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}v d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{o\PYGZus{}proj\PYGZus{}weight}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}model d\PYGZus{}v\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}in\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{token\PYGZus{}positions}\PYG{p}{:} \PYG{n}{Int}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length\PYGZdq{}}\PYG{p}{]} \PYG{o}{|} \PYG{k+kc}{None} \PYG{o}{=} \PYG{k+kc}{None}\PYG{p}{,}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}out\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given the key, query, and value projection weights of a naive unbatched}
\PYG{l+s+sd}{    implementation of multi\PYGZhy{}head attention, return the output of an optimized batched}
\PYG{l+s+sd}{    implementation. This implementation should handle the key, query, and value projections}
\PYG{l+s+sd}{    for all heads in a single matrix multiply.}
\PYG{l+s+sd}{    This version of MHA should include RoPE.}
\PYG{l+s+sd}{    In this case, the RoPE embedding dimension must be the head embedding dimension (d\PYGZus{}model // num\PYGZus{}heads).}
\PYG{l+s+sd}{    See section 3.2.2 of Vaswani et al., 2017.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}model (int): Dimensionality of the feedforward input and output.}
\PYG{l+s+sd}{        num\PYGZus{}heads (int): Number of heads to use in multi\PYGZhy{}headed attention.}
\PYG{l+s+sd}{        max\PYGZus{}seq\PYGZus{}len (int): Maximum sequence length to pre\PYGZhy{}cache if your implementation does that.}
\PYG{l+s+sd}{        theta (float): RoPE parameter.}
\PYG{l+s+sd}{        q\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the Q projection}
\PYG{l+s+sd}{        k\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the K projection}
\PYG{l+s+sd}{        v\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}k d\PYGZus{}in\PYGZdq{}]): Weights for the V projection}
\PYG{l+s+sd}{        o\PYGZus{}proj\PYGZus{}weight (Float[Tensor, \PYGZdq{}d\PYGZus{}model d\PYGZus{}v\PYGZdq{}]): Weights for the output projection}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}... sequence\PYGZus{}length d\PYGZus{}in\PYGZdq{}]): Tensor to run your implementation on.}
\PYG{l+s+sd}{        token\PYGZus{}positions (Int[Tensor, \PYGZdq{} ... sequence\PYGZus{}length\PYGZdq{}] | None): Optional tensor with the positions of the tokens}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}out\PYGZdq{}]: Tensor with the output of running your optimized, batched multi\PYGZhy{}headed attention}
\PYG{l+s+sd}{        implementation with the given QKV projection weights and input features.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 维度准备}
    \PYG{n}{d\PYGZus{}head} \PYG{o}{=} \PYG{n}{d\PYGZus{}model} \PYG{o}{//} \PYG{n}{num\PYGZus{}heads}
    \PYG{n}{seq\PYGZus{}len} \PYG{o}{=} \PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{shape}\PYG{p}{[}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{2}\PYG{p}{]}
    
    \PYG{c+c1}{\PYGZsh{} 2. 线性投影与多头切分 (一步位移)}
    \PYG{c+c1}{\PYGZsh{} 直接投影后切成 [... heads, seq, d\PYGZus{}head]}
    \PYG{n}{Q} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{rearrange}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... s (h d) \PYGZhy{}\PYGZgt{} ... h s d\PYGZdq{}}\PYG{p}{,} \PYG{n}{F}\PYG{o}{.}\PYG{n}{linear}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{,} \PYG{n}{q\PYGZus{}proj\PYGZus{}weight}\PYG{p}{),} \PYG{n}{h}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{)}
    \PYG{n}{K} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{rearrange}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... s (h d) \PYGZhy{}\PYGZgt{} ... h s d\PYGZdq{}}\PYG{p}{,} \PYG{n}{F}\PYG{o}{.}\PYG{n}{linear}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{,} \PYG{n}{k\PYGZus{}proj\PYGZus{}weight}\PYG{p}{),} \PYG{n}{h}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{)}
    \PYG{n}{V} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{rearrange}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... s (h d) \PYGZhy{}\PYGZgt{} ... h s d\PYGZdq{}}\PYG{p}{,} \PYG{n}{F}\PYG{o}{.}\PYG{n}{linear}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{,} \PYG{n}{v\PYGZus{}proj\PYGZus{}weight}\PYG{p}{),} \PYG{n}{h}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 3. 注入 RoPE}
    \PYG{n}{rope} \PYG{o}{=} \PYG{n}{RotaryPositionalEmbedding}\PYG{p}{(}\PYG{n}{theta}\PYG{p}{,} \PYG{n}{d\PYGZus{}head}\PYG{p}{,} \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{,} \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{)}
    \PYG{k}{if} \PYG{n}{token\PYGZus{}positions} \PYG{o+ow}{is} \PYG{k+kc}{None}\PYG{p}{:}
        \PYG{n}{token\PYGZus{}positions} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{arange}\PYG{p}{(}\PYG{n}{seq\PYGZus{}len}\PYG{p}{,} \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 利用 unsqueeze(\PYGZhy{}2) 配合 RoPE 内部的 einx 逻辑进行 heads 维度的广播}
    \PYG{n}{pos\PYGZus{}for\PYGZus{}rope} \PYG{o}{=} \PYG{n}{token\PYGZus{}positions}\PYG{o}{.}\PYG{n}{unsqueeze}\PYG{p}{(}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{2}\PYG{p}{)} 
    \PYG{n}{Q}\PYG{p}{,} \PYG{n}{K} \PYG{o}{=} \PYG{n}{rope}\PYG{p}{(}\PYG{n}{Q}\PYG{p}{,} \PYG{n}{pos\PYGZus{}for\PYGZus{}rope}\PYG{p}{),} \PYG{n}{rope}\PYG{p}{(}\PYG{n}{K}\PYG{p}{,} \PYG{n}{pos\PYGZus{}for\PYGZus{}rope}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 4. 【核心优化】计算注意力打分 (einx.dot)}
    \PYG{c+c1}{\PYGZsh{} 代替 (Q @ K.transpose(\PYGZhy{}2, \PYGZhy{}1))}
    \PYG{c+c1}{\PYGZsh{} 语义：Query(s\PYGZus{}q) 与 Key(s\PYGZus{}k) 在特征维(d)点积，保留 batch(...) 和 head(h)}
    \PYG{n}{logits} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{dot}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... h s\PYGZus{}q d, ... h s\PYGZus{}k d \PYGZhy{}\PYGZgt{} ... h s\PYGZus{}q s\PYGZus{}k\PYGZdq{}}\PYG{p}{,} \PYG{n}{Q}\PYG{p}{,} \PYG{n}{K}\PYG{p}{)} \PYG{o}{/} \PYG{n}{math}\PYG{o}{.}\PYG{n}{sqrt}\PYG{p}{(}\PYG{n}{d\PYGZus{}head}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 5. 因果掩码与归一化}
    \PYG{c+c1}{\PYGZsh{} 这里的 mask 也可以用 einx 思想理解：它只作用于最后两个 s 维度}
    \PYG{n}{mask} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{tril}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{ones}\PYG{p}{(}\PYG{n}{seq\PYGZus{}len}\PYG{p}{,} \PYG{n}{seq\PYGZus{}len}\PYG{p}{,} \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{bool}\PYG{p}{,} \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{))}
    \PYG{c+c1}{\PYGZsh{} 使用 torch.where 配合布尔掩码比 masked\PYGZus{}fill 更符合函数式风格}
    \PYG{n}{attn\PYGZus{}weights} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{softmax}\PYG{p}{(}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{where}\PYG{p}{(}\PYG{n}{mask}\PYG{p}{,} \PYG{n}{logits}\PYG{p}{,} \PYG{n+nb}{float}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}\PYGZhy{}inf\PYGZdq{}}\PYG{p}{)),} \PYG{n}{dim}\PYG{o}{=\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 6. 【核心优化】加权聚合提取 Value (einx.dot)}
    \PYG{c+c1}{\PYGZsh{} 代替 attn\PYGZus{}weights @ V}
    \PYG{c+c1}{\PYGZsh{} 语义：用权重(s\PYGZus{}k)对内容(s\PYGZus{}k)进行加权求和，产出查询位置(s\PYGZus{}q)的特征(d)}
    \PYG{n}{out} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{dot}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... h s\PYGZus{}q s\PYGZus{}k, ... h s\PYGZus{}k d \PYGZhy{}\PYGZgt{} ... h s\PYGZus{}q d\PYGZdq{}}\PYG{p}{,} \PYG{n}{attn\PYGZus{}weights}\PYG{p}{,} \PYG{n}{V}\PYG{p}{)}
    
    \PYG{c+c1}{\PYGZsh{} 7. 缝合多头并最终投影}
    \PYG{n}{out} \PYG{o}{=} \PYG{n}{einx}\PYG{o}{.}\PYG{n}{rearrange}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}... h s d \PYGZhy{}\PYGZgt{} ... s (h d)\PYGZdq{}}\PYG{p}{,} \PYG{n}{out}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{F}\PYG{o}{.}\PYG{n}{linear}\PYG{p}{(}\PYG{n}{out}\PYG{p}{,} \PYG{n}{o\PYGZus{}proj\PYGZus{}weight}\PYG{p}{)}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}rope}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}k}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{theta}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{,}
    \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{in\PYGZus{}query\PYGZus{}or\PYGZus{}key}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}k\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{token\PYGZus{}positions}\PYG{p}{:} \PYG{n}{Int}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}k\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Run RoPE for a given input tensor.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}k (int): Embedding dimension size for the query or key tensor.}
\PYG{l+s+sd}{        theta (float): RoPE parameter.}
\PYG{l+s+sd}{        max\PYGZus{}seq\PYGZus{}len (int): Maximum sequence length to pre\PYGZhy{}cache if your implementation does that.}
\PYG{l+s+sd}{        in\PYGZus{}query\PYGZus{}or\PYGZus{}key (Float[Tensor, \PYGZdq{}... sequence\PYGZus{}length d\PYGZus{}k\PYGZdq{}]): Input tensor to run RoPE on.}
\PYG{l+s+sd}{        token\PYGZus{}positions (Int[Tensor, \PYGZdq{}... sequence\PYGZus{}length\PYGZdq{}]): Tensor of shape (batch\PYGZus{}size, sequence\PYGZus{}length) with the token positions}
\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{} ... sequence\PYGZus{}length d\PYGZus{}k\PYGZdq{}]: Tensor with RoPEd input.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 实例化 RoPE 模块}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{RotaryPositionalEmbedding}\PYG{p}{(}
        \PYG{n}{theta}\PYG{o}{=}\PYG{n}{theta}\PYG{p}{,}
        \PYG{n}{d\PYGZus{}k}\PYG{o}{=}\PYG{n}{d\PYGZus{}k}\PYG{p}{,}
        \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{o}{=}\PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}query\PYGZus{}or\PYGZus{}key}\PYG{o}{.}\PYG{n}{device}
    \PYG{p}{)}


    \PYG{c+c1}{\PYGZsh{} 2. 评估模式并切断梯度，直接计算}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{c+c1}{\PYGZsh{} 注意要把 token\PYGZus{}positions 传进去！}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}query\PYGZus{}or\PYGZus{}key}\PYG{p}{,} \PYG{n}{token\PYGZus{}positions}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}transformer\PYGZus{}block}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{num\PYGZus{}heads}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}ff}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{theta}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{,}
    \PYG{n}{weights}\PYG{p}{:} \PYG{n+nb}{dict}\PYG{p}{[}\PYG{n+nb}{str}\PYG{p}{,} \PYG{n}{Tensor}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch sequence\PYGZus{}length d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch sequence\PYGZus{}length d\PYGZus{}model\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given the weights of a pre\PYGZhy{}norm Transformer block and input features,}
\PYG{l+s+sd}{    return the output of running the Transformer block on the input features.}

\PYG{l+s+sd}{    This function should use RoPE.}
\PYG{l+s+sd}{    Depending on your implementation, you may simply need to pass the relevant args}
\PYG{l+s+sd}{    to your TransformerBlock constructor, or you may need to initialize your own RoPE}
\PYG{l+s+sd}{    class and pass that instead.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}model (int): The dimensionality of the Transformer block input.}
\PYG{l+s+sd}{        num\PYGZus{}heads (int): Number of heads to use in multi\PYGZhy{}headed attention. `d\PYGZus{}model` must be}
\PYG{l+s+sd}{            evenly divisible by `num\PYGZus{}heads`.}
\PYG{l+s+sd}{        d\PYGZus{}ff (int): Dimensionality of the feed\PYGZhy{}forward inner layer.}
\PYG{l+s+sd}{        max\PYGZus{}seq\PYGZus{}len (int): Maximum sequence length to pre\PYGZhy{}cache if your implementation does that.}
\PYG{l+s+sd}{        theta (float): RoPE parameter.}
\PYG{l+s+sd}{        weights (dict[str, Tensor]):}
\PYG{l+s+sd}{            State dict of our reference implementation.}
\PYG{l+s+sd}{            The keys of this dictionary are:}
\PYG{l+s+sd}{            \PYGZhy{} `attn.q\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The query projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}k),}
\PYG{l+s+sd}{                so `attn.q\PYGZus{}proj.weight == torch.cat([q\PYGZus{}heads.0.weight, ..., q\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `attn.k\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The key projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}k),}
\PYG{l+s+sd}{                so `attn.k\PYGZus{}proj.weight == torch.cat([k\PYGZus{}heads.0.weight, ..., k\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `attn.v\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The value projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}v),}
\PYG{l+s+sd}{                so `attn.v\PYGZus{}proj.weight == torch.cat([v\PYGZus{}heads.0.weight, ..., v\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `attn.output\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                Weight of the multi\PYGZhy{}head self\PYGZhy{}attention output projection}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}model).}
\PYG{l+s+sd}{            \PYGZhy{} `ln1.weight`}
\PYG{l+s+sd}{                Weights of affine transform for the first RMSNorm}
\PYG{l+s+sd}{                applied in the transformer block.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model,).}
\PYG{l+s+sd}{            \PYGZhy{} `ffn.w1.weight`}
\PYG{l+s+sd}{                Weight of the first linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}ff).}
\PYG{l+s+sd}{            \PYGZhy{} `ffn.w2.weight`}
\PYG{l+s+sd}{                Weight of the second linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}ff, d\PYGZus{}model).}
\PYG{l+s+sd}{            \PYGZhy{} `ffn.w3.weight`}
\PYG{l+s+sd}{                Weight of the third linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}ff).}
\PYG{l+s+sd}{            \PYGZhy{} `ln2.weight`}
\PYG{l+s+sd}{                Weights of affine transform for the second RMSNorm}
\PYG{l+s+sd}{                applied in the transformer block.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model,).}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}batch sequence\PYGZus{}length d\PYGZus{}model\PYGZdq{}]):}
\PYG{l+s+sd}{            Tensor to run your implementation on.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}batch sequence\PYGZus{}length d\PYGZus{}model\PYGZdq{}] Tensor with the output of}
\PYG{l+s+sd}{        running the Transformer block on the input features while using RoPE.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 实例化}
    \PYG{n}{block} \PYG{o}{=} \PYG{n}{TransformerBlock}\PYG{p}{(}
        \PYG{n}{d\PYGZus{}model}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{num\PYGZus{}heads}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{,}
        \PYG{n}{d\PYGZus{}ff}\PYG{o}{=}\PYG{n}{d\PYGZus{}ff}\PYG{p}{,}
        \PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{o}{=}\PYG{n}{max\PYGZus{}seq\PYGZus{}len}\PYG{p}{,}
        \PYG{n}{theta}\PYG{o}{=}\PYG{n}{theta}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{dtype}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 2. 权重映射}
    \PYG{n}{state\PYGZus{}dict} \PYG{o}{=} \PYG{p}{\PYGZob{}}
        \PYG{l+s+s2}{\PYGZdq{}ln1.weight\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}ln1.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}attn.q\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}attn.q\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}attn.k\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}attn.k\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}attn.v\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}attn.v\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}attn.o\PYGZus{}proj.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}attn.output\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}ln2.weight\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}ln2.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}ffn.w1.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}ffn.w1.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}ffn.w2.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}ffn.w2.weight\PYGZdq{}}\PYG{p}{],}
        \PYG{l+s+s2}{\PYGZdq{}ffn.w3.W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}ffn.w3.weight\PYGZdq{}}\PYG{p}{],}
    \PYG{p}{\PYGZcb{}}

    \PYG{c+c1}{\PYGZsh{} 3. 加载与推理}
    \PYG{n}{block}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(}\PYG{n}{state\PYGZus{}dict}\PYG{p}{,} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}
    \PYG{n}{block}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{block}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}transformer\PYGZus{}lm}\PYG{p}{(}
    \PYG{n}{vocab\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{context\PYGZus{}length}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{num\PYGZus{}layers}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{num\PYGZus{}heads}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}ff}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{rope\PYGZus{}theta}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{,}
    \PYG{n}{weights}\PYG{p}{:} \PYG{n+nb}{dict}\PYG{p}{[}\PYG{n+nb}{str}\PYG{p}{,} \PYG{n}{Tensor}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}indices}\PYG{p}{:} \PYG{n}{Int}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch\PYGZus{}size sequence\PYGZus{}length\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch\PYGZus{}size sequence\PYGZus{}length vocab\PYGZus{}size\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sa}{r}\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Given the weights of a Transformer language model and input indices,}
\PYG{l+s+sd}{    return the output of running a forward pass on the input indices.}

\PYG{l+s+sd}{    This function should use RoPE.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        vocab\PYGZus{}size (int): The number of unique items in the output vocabulary to be predicted.}
\PYG{l+s+sd}{        context\PYGZus{}length (int): The maximum number of tokens to process at once.}
\PYG{l+s+sd}{        d\PYGZus{}model (int): The dimensionality of the model embeddings and sublayer outputs.}
\PYG{l+s+sd}{        num\PYGZus{}layers (int): The number of Transformer layers to use.}
\PYG{l+s+sd}{        num\PYGZus{}heads (int): Number of heads to use in multi\PYGZhy{}headed attention. `d\PYGZus{}model` must be}
\PYG{l+s+sd}{            evenly divisible by `num\PYGZus{}heads`.}
\PYG{l+s+sd}{        d\PYGZus{}ff (int): Dimensionality of the feed\PYGZhy{}forward inner layer (section 3.3).}
\PYG{l+s+sd}{        rope\PYGZus{}theta (float): The RoPE \PYGZdl{}\PYGZbs{}Theta\PYGZdl{} parameter.}
\PYG{l+s+sd}{        weights (dict[str, Tensor]):}
\PYG{l+s+sd}{            State dict of our reference implementation. \PYGZob{}num\PYGZus{}layers\PYGZcb{} refers to an}
\PYG{l+s+sd}{            integer between `0` and `num\PYGZus{}layers \PYGZhy{} 1` (the layer index).}
\PYG{l+s+sd}{            The keys of this dictionary are:}
\PYG{l+s+sd}{            \PYGZhy{} `token\PYGZus{}embeddings.weight`}
\PYG{l+s+sd}{                Token embedding matrix. Shape is (vocab\PYGZus{}size, d\PYGZus{}model).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.attn.q\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The query projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (num\PYGZus{}heads * (d\PYGZus{}model / num\PYGZus{}heads), d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}k),}
\PYG{l+s+sd}{                so `attn.q\PYGZus{}proj.weight == torch.cat([q\PYGZus{}heads.0.weight, ..., q\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.attn.k\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The key projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (num\PYGZus{}heads * (d\PYGZus{}model / num\PYGZus{}heads), d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}k),}
\PYG{l+s+sd}{                so `attn.k\PYGZus{}proj.weight == torch.cat([k\PYGZus{}heads.0.weight, ..., k\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.attn.v\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                The value projections for all `num\PYGZus{}heads` attention heads.}
\PYG{l+s+sd}{                Shape is (num\PYGZus{}heads * (d\PYGZus{}model / num\PYGZus{}heads), d\PYGZus{}model).}
\PYG{l+s+sd}{                The rows are ordered by matrices of shape (num\PYGZus{}heads, d\PYGZus{}v),}
\PYG{l+s+sd}{                so `attn.v\PYGZus{}proj.weight == torch.cat([v\PYGZus{}heads.0.weight, ..., v\PYGZus{}heads.N.weight], dim=0)`.}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.attn.output\PYGZus{}proj.weight`}
\PYG{l+s+sd}{                Weight of the multi\PYGZhy{}head self\PYGZhy{}attention output projection}
\PYG{l+s+sd}{                Shape is ((d\PYGZus{}model / num\PYGZus{}heads) * num\PYGZus{}heads, d\PYGZus{}model).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.ln1.weight`}
\PYG{l+s+sd}{                Weights of affine transform for the first RMSNorm}
\PYG{l+s+sd}{                applied in the transformer block.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model,).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.ffn.w1.weight`}
\PYG{l+s+sd}{                Weight of the first linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}ff).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.ffn.w2.weight`}
\PYG{l+s+sd}{                Weight of the second linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}ff, d\PYGZus{}model).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.ffn.w3.weight`}
\PYG{l+s+sd}{                Weight of the third linear transformation in the FFN.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, d\PYGZus{}ff).}
\PYG{l+s+sd}{            \PYGZhy{} `layers.\PYGZob{}num\PYGZus{}layers\PYGZcb{}.ln2.weight`}
\PYG{l+s+sd}{                Weights of affine transform for the second RMSNorm}
\PYG{l+s+sd}{                applied in the transformer block.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model,).}
\PYG{l+s+sd}{            \PYGZhy{} `ln\PYGZus{}final.weight`}
\PYG{l+s+sd}{                Weights of affine transform for RMSNorm applied to the output of the final transformer block.}
\PYG{l+s+sd}{                Shape is (d\PYGZus{}model, ).}
\PYG{l+s+sd}{            \PYGZhy{} `lm\PYGZus{}head.weight`}
\PYG{l+s+sd}{                Weights of the language model output embedding.}
\PYG{l+s+sd}{                Shape is (vocab\PYGZus{}size, d\PYGZus{}model).}
\PYG{l+s+sd}{        in\PYGZus{}indices (Int[Tensor, \PYGZdq{}batch\PYGZus{}size sequence\PYGZus{}length\PYGZdq{}]) Tensor with input indices to run the language model on. Shape is (batch\PYGZus{}size, sequence\PYGZus{}length), where}
\PYG{l+s+sd}{            `sequence\PYGZus{}length` is at most `context\PYGZus{}length`.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}batch\PYGZus{}size sequence\PYGZus{}length vocab\PYGZus{}size\PYGZdq{}]: Tensor with the predicted unnormalized}
\PYG{l+s+sd}{        next\PYGZhy{}word distribution for each token.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 实例化完整的语言模型}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{TransformerLM}\PYG{p}{(}
        \PYG{n}{vocab\PYGZus{}size}\PYG{o}{=}\PYG{n}{vocab\PYGZus{}size}\PYG{p}{,}
        \PYG{n}{context\PYGZus{}length}\PYG{o}{=}\PYG{n}{context\PYGZus{}length}\PYG{p}{,}
        \PYG{n}{num\PYGZus{}layers}\PYG{o}{=}\PYG{n}{num\PYGZus{}layers}\PYG{p}{,}
        \PYG{n}{d\PYGZus{}model}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{num\PYGZus{}heads}\PYG{o}{=}\PYG{n}{num\PYGZus{}heads}\PYG{p}{,}
        \PYG{n}{d\PYGZus{}ff}\PYG{o}{=}\PYG{n}{d\PYGZus{}ff}\PYG{p}{,}
        \PYG{n}{theta}\PYG{o}{=}\PYG{n}{rope\PYGZus{}theta}\PYG{p}{,}  \PYG{c+c1}{\PYGZsh{} 把外部的 rope\PYGZus{}theta 传给内部需要的 theta}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}indices}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,} \PYG{c+c1}{\PYGZsh{} 使用 in\PYGZus{}indices 所在的设备}
    \PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 2. 疯狂的权重重映射 (The Great Weight Remapping)}
    \PYG{n}{state\PYGZus{}dict} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}
    
    \PYG{k}{for} \PYG{n}{key}\PYG{p}{,} \PYG{n}{tensor} \PYG{o+ow}{in} \PYG{n}{weights}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
        \PYG{c+c1}{\PYGZsh{} A. 映射 Embedding (老师的键有 \PYGZsq{}s\PYGZsq{}：token\PYGZus{}embeddings)}
        \PYG{k}{if} \PYG{n}{key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}token\PYGZus{}embeddings.weight\PYGZdq{}}\PYG{p}{:}
            \PYG{n}{state\PYGZus{}dict}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}token\PYGZus{}embedding.weight\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{tensor}
            
        \PYG{c+c1}{\PYGZsh{} B. 映射最后的 RMSNorm (老师的键叫 ln\PYGZus{}final)}
        \PYG{k}{elif} \PYG{n}{key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ln\PYGZus{}final.weight\PYGZdq{}}\PYG{p}{:}
            \PYG{n}{state\PYGZus{}dict}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}final\PYGZus{}norm.weight\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{tensor}
            
        \PYG{c+c1}{\PYGZsh{} C. 映射输出预测头 LM Head}
        \PYG{k}{elif} \PYG{n}{key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}output.weight\PYGZdq{}}\PYG{p}{:}
            \PYG{n}{state\PYGZus{}dict}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}lm\PYGZus{}head.weight\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{tensor}
            
        \PYG{c+c1}{\PYGZsh{} D. 动态映射所有的 Transformer Layers (0, 1, 2... n)}
        \PYG{k}{elif} \PYG{n}{key}\PYG{o}{.}\PYG{n}{startswith}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}layers.\PYGZdq{}}\PYG{p}{):}
            \PYG{n}{parts} \PYG{o}{=} \PYG{n}{key}\PYG{o}{.}\PYG{n}{split}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}.\PYGZdq{}}\PYG{p}{)}
            \PYG{n}{layer\PYGZus{}idx} \PYG{o}{=} \PYG{n}{parts}\PYG{p}{[}\PYG{l+m+mi}{1}\PYG{p}{]}  
            \PYG{n}{sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}.\PYGZdq{}}\PYG{o}{.}\PYG{n}{join}\PYG{p}{(}\PYG{n}{parts}\PYG{p}{[}\PYG{l+m+mi}{2}\PYG{p}{:])}  
            
            \PYG{k}{if} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ln1.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}ln1.weight\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}attn.q\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}attn.q\PYGZus{}proj.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}attn.k\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}attn.k\PYGZus{}proj.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}attn.v\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}attn.v\PYGZus{}proj.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}attn.output\PYGZus{}proj.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}attn.o\PYGZus{}proj.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ln2.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}ln2.weight\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ffn.w1.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}ffn.w1.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ffn.w2.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}ffn.w2.W\PYGZdq{}}
            \PYG{k}{elif} \PYG{n}{sub\PYGZus{}key} \PYG{o}{==} \PYG{l+s+s2}{\PYGZdq{}ffn.w3.weight\PYGZdq{}}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}ffn.w3.W\PYGZdq{}}
            \PYG{k}{else}\PYG{p}{:}
                \PYG{n}{new\PYGZus{}sub\PYGZus{}key} \PYG{o}{=} \PYG{n}{sub\PYGZus{}key}  
                
            \PYG{n}{state\PYGZus{}dict}\PYG{p}{[}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}layers.}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{layer\PYGZus{}idx}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{.}\PYG{l+s+si}{\PYGZob{}}\PYG{n}{new\PYGZus{}sub\PYGZus{}key}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{tensor}
            
        \PYG{c+c1}{\PYGZsh{} E. 兜底策略}
        \PYG{k}{else}\PYG{p}{:}
            \PYG{n}{state\PYGZus{}dict}\PYG{p}{[}\PYG{n}{key}\PYG{p}{]} \PYG{o}{=} \PYG{n}{tensor}

    \PYG{c+c1}{\PYGZsh{} 3. 严格加载映射好的权重}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(}\PYG{n}{state\PYGZus{}dict}\PYG{p}{,} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 4. 执行神圣的前向推理}
    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{c+c1}{\PYGZsh{} 注意：这里传进去的参数变成了 in\PYGZus{}indices}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}indices}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}rmsnorm}\PYG{p}{(}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{eps}\PYG{p}{:} \PYG{n+nb}{float}\PYG{p}{,}
    \PYG{n}{weights}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
    \PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}model\PYGZdq{}}\PYG{p}{],}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}model\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Given the weights of a RMSNorm affine transform,}
\PYG{l+s+sd}{    return the output of running RMSNorm on the input features.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        d\PYGZus{}model (int): The dimensionality of the RMSNorm input.}
\PYG{l+s+sd}{        eps: (float): A value added to the denominator for numerical stability.}
\PYG{l+s+sd}{        weights (Float[Tensor, \PYGZdq{}d\PYGZus{}model\PYGZdq{}]): RMSNorm weights.}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}... d\PYGZus{}model\PYGZdq{}]): Input features to run RMSNorm on. Can have arbitrary leading}
\PYG{l+s+sd}{            dimensions.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor,\PYGZdq{}... d\PYGZus{}model\PYGZdq{}]: Tensor of with the same shape as `in\PYGZus{}features` with the output of running}
\PYG{l+s+sd}{        RMSNorm of the `in\PYGZus{}features`.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{model} \PYG{o}{=} \PYG{n}{RMSNorm}\PYG{p}{(}
        \PYG{n}{d\PYGZus{}model}\PYG{o}{=}\PYG{n}{d\PYGZus{}model}\PYG{p}{,}
        \PYG{n}{eps}\PYG{o}{=}\PYG{n}{eps}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{weights}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{weights}\PYG{o}{.}\PYG{n}{dtype}
    \PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}weight\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{\PYGZcb{},} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{)}
        
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}silu}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ...\PYGZdq{}}\PYG{p}{])} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ...\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Given a tensor of inputs, return the output of applying SiLU}
\PYG{l+s+sd}{    to each element.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        in\PYGZus{}features(Float[Tensor, \PYGZdq{}...\PYGZdq{}]): Input features to run SiLU on. Shape is arbitrary.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor,\PYGZdq{}...\PYGZdq{}]: of with the same shape as `in\PYGZus{}features` with the output of applying}
\PYG{l+s+sd}{        SiLU to each element.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{k}{raise} \PYG{n+ne}{NotImplementedError}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}get\PYGZus{}batch}\PYG{p}{(}
    \PYG{n}{dataset}\PYG{p}{:} \PYG{n}{npt}\PYG{o}{.}\PYG{n}{NDArray}\PYG{p}{,} \PYG{n}{batch\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{context\PYGZus{}length}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,} \PYG{n}{device}\PYG{p}{:} \PYG{n+nb}{str}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n+nb}{tuple}\PYG{p}{[}\PYG{n}{torch}\PYG{o}{.}\PYG{n}{Tensor}\PYG{p}{,} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{Tensor}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given a dataset (a 1D numpy array of integers) and a desired batch size and}
\PYG{l+s+sd}{    context length, sample language modeling input sequences and their corresponding}
\PYG{l+s+sd}{    labels from the dataset.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        dataset (np.array): 1D numpy array of integer token IDs in the dataset.}
\PYG{l+s+sd}{        batch\PYGZus{}size (int): Desired batch size to sample.}
\PYG{l+s+sd}{        context\PYGZus{}length (int): Desired context length of each sampled example.}
\PYG{l+s+sd}{        device (str): PyTorch device string (e.g., \PYGZsq{}cpu\PYGZsq{} or \PYGZsq{}cuda:0\PYGZsq{}) indicating the device}
\PYG{l+s+sd}{            to place the sampled input sequences and labels on.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Tuple of torch.LongTensors of shape (batch\PYGZus{}size, context\PYGZus{}length). The first tuple item}
\PYG{l+s+sd}{        is the sampled input sequences, and the second tuple item is the corresponding}
\PYG{l+s+sd}{        language modeling labels.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{k}{raise} \PYG{n+ne}{NotImplementedError}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}softmax}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ...\PYGZdq{}}\PYG{p}{],} \PYG{n}{dim}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ...\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given a tensor of inputs, return the output of softmaxing the given `dim`}
\PYG{l+s+sd}{    of the input.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}...\PYGZdq{}]): Input features to softmax. Shape is arbitrary.}
\PYG{l+s+sd}{        dim (int): Dimension of the `in\PYGZus{}features` to apply softmax to.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}...\PYGZdq{}]: Tensor of with the same shape as `in\PYGZus{}features` with the output of}
\PYG{l+s+sd}{        softmax normalizing the specified `dim`.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{c+c1}{\PYGZsh{} 1. 寻找指定维度上的最大值}
    \PYG{c+c1}{\PYGZsh{} keepdim=True 是灵魂！它能保留维度形状（比如把形状从 [3, 4] 变成 [3, 1]），}
    \PYG{c+c1}{\PYGZsh{} 这样后续减法时才能正确触发广播机制 (Broadcasting)。}
    \PYG{c+c1}{\PYGZsh{} 注意：torch.max 会返回一个元组 (values, indices)，我们只需要取第 0 项的 values。}
    \PYG{n}{max\PYGZus{}vals} \PYG{o}{=} \PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{max}\PYG{p}{(}\PYG{n}{dim}\PYG{o}{=}\PYG{n}{dim}\PYG{p}{,} \PYG{n}{keepdim}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)[}\PYG{l+m+mi}{0}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} 2. Max Trick：平移输入值，防止指数爆炸}
    \PYG{n}{shifted\PYGZus{}logits} \PYG{o}{=} \PYG{n}{in\PYGZus{}features} \PYG{o}{\PYGZhy{}} \PYG{n}{max\PYGZus{}vals}

    \PYG{c+c1}{\PYGZsh{} 3. 计算指数 (现在所有的输入都 \PYGZlt{}= 0，所以 exp 的结果都在 0\PYGZti{}1 之间，绝对安全)}
    \PYG{n}{exps} \PYG{o}{=} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{exp}\PYG{p}{(}\PYG{n}{shifted\PYGZus{}logits}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 4. 沿着指定维度求和，作为分母}
    \PYG{n}{sum\PYGZus{}exps} \PYG{o}{=} \PYG{n}{exps}\PYG{o}{.}\PYG{n}{sum}\PYG{p}{(}\PYG{n}{dim}\PYG{o}{=}\PYG{n}{dim}\PYG{p}{,} \PYG{n}{keepdim}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} 5. 归一化，得到最终的概率分布}
    \PYG{n}{probabilities} \PYG{o}{=} \PYG{n}{exps} \PYG{o}{/} \PYG{n}{sum\PYGZus{}exps}

    \PYG{k}{return} \PYG{n}{probabilities}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}cross\PYGZus{}entropy}\PYG{p}{(}
    \PYG{n}{inputs}\PYG{p}{:} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch\PYGZus{}size vocab\PYGZus{}size\PYGZdq{}}\PYG{p}{],} \PYG{n}{targets}\PYG{p}{:} \PYG{n}{Int}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} batch\PYGZus{}size\PYGZdq{}}\PYG{p}{]}
\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Given a tensor of inputs and targets, compute the average cross\PYGZhy{}entropy}
\PYG{l+s+sd}{    loss across examples.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        inputs (Float[Tensor, \PYGZdq{}batch\PYGZus{}size vocab\PYGZus{}size\PYGZdq{}]): inputs[i][j] is the}
\PYG{l+s+sd}{            unnormalized logit of jth class for the ith example.}
\PYG{l+s+sd}{        targets (Int[Tensor, \PYGZdq{}batch\PYGZus{}size\PYGZdq{}]): Tensor of shape (batch\PYGZus{}size,) with the index of the correct class.}
\PYG{l+s+sd}{            Each value must be between 0 and `num\PYGZus{}classes \PYGZhy{} 1`.}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}\PYGZdq{}]: The average cross\PYGZhy{}entropy loss across examples.}
