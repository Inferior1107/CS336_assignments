\PYG{p}{)} \PYG{o}{\PYGZhy{}\PYGZgt{}} \PYG{n}{Float}\PYG{p}{[}\PYG{n}{Tensor}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{} ... d\PYGZus{}out\PYGZdq{}}\PYG{p}{]:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Given the weights of a Linear layer, compute the transformation of a batched input.}

\PYG{l+s+sd}{    Args:}
\PYG{l+s+sd}{        in\PYGZus{}dim (int): The size of the input dimension}
\PYG{l+s+sd}{        out\PYGZus{}dim (int): The size of the output dimension}
\PYG{l+s+sd}{        weights (Float[Tensor, \PYGZdq{}d\PYGZus{}out d\PYGZus{}in\PYGZdq{}]): The linear weights to use}
\PYG{l+s+sd}{        in\PYGZus{}features (Float[Tensor, \PYGZdq{}... d\PYGZus{}in\PYGZdq{}]): The output tensor to apply the function to}

\PYG{l+s+sd}{    Returns:}
\PYG{l+s+sd}{        Float[Tensor, \PYGZdq{}... d\PYGZus{}out\PYGZdq{}]: The transformed output of your linear module.}
\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{model} \PYG{o}{=} \PYG{n}{Linear}\PYG{p}{(}
        \PYG{n}{in\PYGZus{}features}\PYG{o}{=}\PYG{n}{d\PYGZus{}in}\PYG{p}{,}
        \PYG{n}{out\PYGZus{}features}\PYG{o}{=}\PYG{n}{d\PYGZus{}out}\PYG{p}{,}
        \PYG{n}{device}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{device}\PYG{p}{,}
        \PYG{n}{dtype}\PYG{o}{=}\PYG{n}{in\PYGZus{}features}\PYG{o}{.}\PYG{n}{dtype}\PYG{p}{,}
    \PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{load\PYGZus{}state\PYGZus{}dict}\PYG{p}{(\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}W\PYGZdq{}}\PYG{p}{:} \PYG{n}{weights}\PYG{p}{\PYGZcb{},} \PYG{n}{strict}\PYG{o}{=}\PYG{k+kc}{True}\PYG{p}{)}

    \PYG{n}{model}\PYG{o}{.}\PYG{n}{eval}\PYG{p}{()}
    \PYG{k}{with} \PYG{n}{torch}\PYG{o}{.}\PYG{n}{no\PYGZus{}grad}\PYG{p}{():}
        \PYG{n}{output} \PYG{o}{=} \PYG{n}{model}\PYG{p}{(}\PYG{n}{in\PYGZus{}features}\PYG{p}{)}
    
    \PYG{k}{return} \PYG{n}{output}


\PYG{k}{def} \PYG{n+nf}{run\PYGZus{}embedding}\PYG{p}{(}
    \PYG{n}{vocab\PYGZus{}size}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
    \PYG{n}{d\PYGZus{}model}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{,}
